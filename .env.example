# PharmaSafe-KG Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit the real .env file

# ── Relational Database (PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/pharmasafe

# ── Neo4j AuraDB Knowledge Graph ──────────────────────────────────────────────
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your-instance-id
AURA_INSTANCENAME=pharmasafe-kg

# ── API Server Configuration ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://localhost:3000,http://localhost:5173
ENVIRONMENT=development

# ── JWT Authentication & Session Security ─────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
