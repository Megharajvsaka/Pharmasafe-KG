# ═══════════════════════════════════════════════════════════════════════════════
# PharmaSafe-KG .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ── Python bytecode & caches ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Environment & secrets (NEVER commit credentials) ─────────────────────────
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ── Data files (too large for Git, downloaded separately) ─────────────────────
phase1/data/
phase1/outputs/
phase1/logs/
phase2/outputs/
phase2/logs/
phase4/colab_data/

# ── GNN model weights & embeddings (large binary files) ──────────────────────
*.pt
*.pth
*.onnx
*.h5

# ── Generated images from training ───────────────────────────────────────────
phase4/training_curves.png

# ── IDE & editor settings ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Distribution & packaging ────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Testing & coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Jupyter notebooks checkpoints ───────────────────────────────────────────
.ipynb_checkpoints/

# ── OS & Local DB generated files ───────────────────────────────────────────
*.log
*.tmp
*.bak
*.db
*.sqlite3

# ── Clean Architecture Data & Logs ──────────────────────────────────────────
data_pipeline/data/
data_pipeline/outputs/
data_pipeline/logs/
ml_engine/data/
*.db
*.sqlite
*.sqlite3
frontend/.next/
frontend/node_modules/
